# -- Resolution -----------------------------------------------------------
# Reproducible installs: never drift to newer patch/minor versions.
save-exact=true
package-lock=true

# -- Registry -------------------------------------------------------------
registry=https://registry.npmjs.org/

# -- Security -------------------------------------------------------------
# Fail installs when the project's engines requirement is not met.
engine-strict=true
# Always run the audit on install; warn only at/above "high" severity.
audit=true
audit-level=high

# -- Hygiene --------------------------------------------------------------
# No donation prompts, no update notifier noise (CI output stays clean).
fund=false
update-notifier=false