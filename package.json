{
  "name": "johannlaqua.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo of johannlaqua.com: the Astro site, its design system, and the deployment pipeline.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "basic-ftp": "6.2.6",
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "prettier-plugin-astro": "1.1.2",
    "typescript-eslint": "8.72.2"
  },
  "scripts": {
    "dev": "npm run dev -w @johannlaqua/site",
    "build": "npm run build -w @johannlaqua/site",
    "preview": "npm run preview -w @johannlaqua/site",
    "check": "npm run check --workspaces --if-present && npm run lint && npm run format:check",
    "check:links": "npm -w @johannlaqua/site run build && npm -w @johannlaqua/site run check:links",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "npm -w @johannlaqua/site run build && lhci autorun",
    "test:unit": "npm run test:unit -w @johannlaqua/site",
    "test:e2e": "npm run test:e2e -w @johannlaqua/site",
    "test": "npm run test -w @johannlaqua/site",
    "design:build": "npm run build -w @johannlaqua/design-system"
  }
}
