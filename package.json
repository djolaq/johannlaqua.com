{
  "name": "johannlaqua.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo of johannlaqua.com: the Astro site, its design system, and the deployment pipeline.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "npm run dev -w @johannlaqua/site",
    "build": "npm run build -w @johannlaqua/site",
    "preview": "npm run preview -w @johannlaqua/site",
    "check": "npm run check --workspaces --if-present",
    "test:unit": "npm run test:unit -w @johannlaqua/site",
    "test:e2e": "npm run test:e2e -w @johannlaqua/site",
    "test": "npm run test -w @johannlaqua/site",
    "design:build": "npm run build -w @johannlaqua/design-system"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
