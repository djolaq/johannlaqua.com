---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  href: string;
  variant?: 'primary' | 'quiet';
  size?: 'md' | 'sm';
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', external = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {external && <span aria-hidden="true">↗</span>}
  {external && <span class="visually-hidden">{` ${t('aria.newTab')}`}</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .btn--md {
    min-height: 3rem;
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-base);
  }

  .btn--sm {
    min-height: 2.25rem;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .btn--primary {
    background: var(--accent-fill);
    color: var(--on-blue);
    box-shadow: 0 8px 28px -10px var(--blue-glow);
  }

  .btn--primary:hover {
    background: var(--accent-fill-hover);
  }

  .btn--quiet {
    color: var(--text);
    background: var(--sand-veil);
    box-shadow: inset 0 0 0 var(--line-hair) var(--rule);
  }

  .btn--quiet:hover {
    box-shadow: inset 0 0 0 var(--line-hair) var(--text-muted);
  }

  .btn:active {
    translate: 0 1px;
  }
</style>
