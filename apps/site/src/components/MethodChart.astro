---
/**
 * Glass card with the site's one chart: an illustrative diagram (no data)
 * of the working method — delivery speed climbs at each step while
 * technical debt stays flat.
 */
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = [t('chart.step1'), t('chart.step2'), t('chart.step3'), t('chart.step4')];
---

<figure class="chart card">
  <figcaption class="chart__head">
    <span class="chart__kicker">{t('chart.kicker')}</span>
    <span class="chart__title">{t('chart.title')}</span>
  </figcaption>

  <svg
    class="chart__plot"
    viewBox="0 0 320 120"
    width="320"
    height="120"
    preserveAspectRatio="none"
    role="img"
    aria-label={t('chart.alt')}>
    <defs>
      <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--blue-500)" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="var(--blue-500)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <g class="chart__grid">
      <line x1="0" y1="30" x2="320" y2="30"></line>
      <line x1="0" y1="60" x2="320" y2="60"></line>
      <line x1="0" y1="90" x2="320" y2="90"></line>
    </g>
    <path
      class="chart__area"
      d="M0 104 C 40 100, 60 92, 90 86 S 140 70, 170 62 S 220 40, 250 34 S 300 18, 320 12 L 320 120 L 0 120 Z"
      fill="url(#chart-fill)"></path>
    <path class="chart__speed" d="M0 104 C 40 100, 60 92, 90 86 S 140 70, 170 62 S 220 40, 250 34 S 300 18, 320 12"></path>
    <path class="chart__debt" d="M0 100 C 80 99, 160 101, 240 98 S 300 99, 320 98"></path>
  </svg>

  <div class="chart__axis" aria-hidden="true">
    {steps.map((step) => <span>{step}</span>)}
  </div>

  <ul class="chart__legend">
    <li><span class="chart__swatch chart__swatch--speed" aria-hidden="true"></span>{t('chart.speed')}</li>
    <li><span class="chart__swatch chart__swatch--debt" aria-hidden="true"></span>{t('chart.debt')}</li>
  </ul>
</figure>

<style>
  .chart {
    margin: 0;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
  }

  .chart__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .chart__kicker {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }

  .chart__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
  }

  .chart__plot {
    width: 100%;
    height: 7.5rem;
    margin-top: var(--space-4);
    overflow: visible;
  }

  .chart__grid line {
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .chart__speed,
  .chart__debt {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .chart__speed {
    stroke: var(--blue-500);
    stroke-width: 2.5;
    stroke-dasharray: 600;
    animation: chart-draw var(--duration-trace) var(--ease-out) 400ms both;
  }

  .chart__area {
    animation: chart-fade var(--duration-trace) var(--ease-out) 700ms both;
  }

  .chart__debt {
    stroke: var(--sand-500);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .chart__axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--line-hair) solid var(--rule);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .chart__legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .chart__swatch {
    width: var(--space-4);
    height: 0;
    border-top: var(--line-bold) solid var(--blue-500);
  }

  .chart__swatch--debt {
    border-top: var(--line-hair) dashed var(--sand-500);
  }

  @keyframes chart-draw {
    from {
      stroke-dashoffset: 600;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes chart-fade {
    from {
      opacity: 0;
    }
  }
</style>
