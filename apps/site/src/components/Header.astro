---
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import { name } from '../config/site';
import LanguageToggle from './LanguageToggle.astro';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');

const navItems = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: `${home}#lab`, label: t('nav.lab') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={home} class="header__brand">
      <svg class="header__mark" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M9.5 1 3 9h4.5L6.5 15 13 7H8.5z" fill="currentColor"></path>
      </svg>
      {name}
    </a>

    <nav class="header__nav" aria-label={t('aria.primaryNav')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageToggle locale={locale} href={altHref} />
      <Button href={`${home}#contact`} variant="quiet" size="sm">{t('header.cta')}</Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--charcoal-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border-bottom: var(--line-hair) solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    min-height: var(--header-height);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
  }

  .header__mark {
    width: 1rem;
    height: 1rem;
    color: var(--blue-500);
  }

  .header__nav {
    flex: 1;
    min-width: 0;
  }

  .header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .header__nav a {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .header__nav a:hover {
    color: var(--text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 48em) {
    .header__inner {
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-4);
      padding-block: var(--space-3);
    }

    .header__brand {
      flex: 1;
    }

    .header__nav {
      order: 3;
      flex-basis: 100%;
    }

    .header__nav ul {
      gap: var(--space-3);
    }
  }
</style>
