---
import { ariaCurrent, useTranslations, localizePath, type Locale } from '../i18n/utils';
import { name } from '../config/site';
import LanguageToggle from './LanguageToggle.astro';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  altHref?: string;
  /** See LanguageToggle: set on pages without a URL of their own. */
  selfHref?: string;
}

const { locale, altHref, selfHref } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');

const navItems = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: `${home}#lab`, label: t('nav.lab') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={home} class="header__brand target">
      <svg class="header__mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M9.5 1 3 9h4.5L6.5 15 13 7H8.5z" fill="currentColor"></path>
      </svg>
      {name}
    </a>

    <nav class="header__nav" aria-label={t('aria.primaryNav')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a class="target" href={item.href} aria-current={ariaCurrent(item.href, Astro.url.pathname)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageToggle locale={locale} href={altHref} selfHref={selfHref} />
      <Button href={`${home}#contact`} variant="quiet" size="sm">{t('header.cta')}</Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--charcoal-glass);
    backdrop-filter: blur(var(--blur-glass));
    -webkit-backdrop-filter: blur(var(--blur-glass));
    border-bottom: var(--line-hair) solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    min-height: var(--header-height);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
  }

  .header__mark {
    width: 1rem;
    height: 1rem;
    color: var(--blue-500);
  }

  .header__nav {
    flex: 1;
    min-width: 0;
  }

  .header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .header__nav a {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .header__nav a:hover,
  .header__nav a[aria-current] {
    color: var(--text);
  }

  .header__nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent-stroke);
    text-decoration-thickness: var(--line-bold);
    text-underline-offset: 0.35em;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 48em) {
    .header__inner {
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-4);
      padding-block: var(--space-3);
    }

    /* The name never shrinks under its own text: if the row runs out of
       room, the actions wrap instead of sliding over it. */
    .header__brand {
      flex: 1 0 auto;
    }

    .header__nav {
      order: 3;
      flex-basis: 100%;
    }

    .header__nav ul {
      gap: var(--space-3);
    }
  }

  /* Below 26em the name, both languages and the button cannot share a row.
     The button goes: Contact stays in the footer nav and the contact section. */
  @media (max-width: 26em) {
    .header__actions :global(.btn) {
      display: none;
    }
  }
</style>
