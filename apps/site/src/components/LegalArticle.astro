---
import { useTranslations, formatDate, isoDate, type Locale } from '../i18n/utils';
import { legal } from '../data/legal';
import Section from './Section.astro';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const t = useTranslations(locale);
const updated = new Date(legal.lastUpdated);
---

<Section>
  <article class="legal">
    <p class="kicker">{t('legal.eyebrow')}</p>
    <h1 class="legal__title">{title}</h1>
    <p class="legal__updated">{t('legal.updated')} <time datetime={isoDate(updated)}>{formatDate(updated, locale)}</time></p>
    <div class="legal__body prose">
      <slot />
    </div>
  </article>
</Section>

<style>
  .legal {
    max-width: 46rem;
  }

  .legal__title {
    margin-top: var(--space-5);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .legal__updated {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .legal__body {
    margin-top: var(--space-7);
  }

  @media (min-width: 48em) {
    .legal__title {
      font-size: var(--text-4xl);
    }
  }
</style>
