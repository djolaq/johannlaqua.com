---
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import Button from './Button.astro';
import { email, social } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="contact" class="contact">
  <div class="contact__panel card">
    <div class="guides" aria-hidden="true"></div>
    <div class="contact__content">
      <p class="kicker">{t('contact.eyebrow')}</p>
      <h2 class="contact__title">{t('contact.title')}</h2>
      <p class="contact__subtitle">{t('contact.subtitle')}</p>

      <div class="contact__actions">
        <Button href={`mailto:${email}`}>{t('contact.cta')}</Button>
        <span class="contact__email mono">{email}</span>
      </div>
    </div>

    <div class="contact__social">
      <p>{t('contact.social')}</p>
      <ul>
        {social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener noreferrer">
              {s.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .contact__panel {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-7);
    padding: var(--space-7) var(--space-5);
    border-radius: var(--radius-lg);
    background: radial-gradient(60% 80% at 100% 0%, var(--blue-glow), transparent 70%), var(--surface-raised);
  }

  .contact__content {
    position: relative;
  }

  .contact__title {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .contact__subtitle {
    margin-top: var(--space-5);
    max-width: 30rem;
    color: var(--text-muted);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-7);
  }

  .contact__email {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .contact__social {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .contact__social p {
    color: var(--text-muted);
  }

  .contact__social ul {
    display: flex;
    gap: var(--space-5);
  }

  .contact__social a {
    font-weight: var(--weight-medium);
    color: var(--text);
    text-decoration: none;
  }

  .contact__social a:hover {
    color: var(--blue-300);
  }

  @media (min-width: 56em) {
    .contact__panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      padding: var(--space-9) var(--space-8);
    }

    .contact__title {
      font-size: var(--text-5xl);
    }
  }
</style>
