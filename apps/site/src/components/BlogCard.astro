---
import { useTranslations, formatDate, isoDate, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  /** Heading level, so the card fits the outline of the page it sits on (h2 on the blog index, h3 under a section heading). */
  headingLevel?: 'h2' | 'h3';
}

const { locale, href, title, description, date, tags, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(locale);
---

<article class="post-card card">
  <a class="post-card__link" href={href}>
    <div class="post-card__meta">
      <time class="mono" datetime={isoDate(date)}>{formatDate(date, locale)}</time>
      {tags.length > 0 && <span class="post-card__tag">{tags[0]}</span>}
    </div>
    <Heading class="post-card__title">{title}</Heading>
    <p class="post-card__description">{description}</p>
    <span class="post-card__cta">{t('blog.readMore')}</span>
  </a>
</article>

<style>
  .post-card {
    transition:
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--text-faint);
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-card__tag {
    padding: 0.2em 0.65em;
    border: var(--line-hair) solid var(--rule);
    border-radius: var(--radius-full);
  }

  .post-card__title {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .post-card__description {
    flex: 1;
    font-size: var(--text-sm);
    line-height: var(--leading-text);
    color: var(--text-muted);
  }

  .post-card__cta {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--link);
  }
</style>
