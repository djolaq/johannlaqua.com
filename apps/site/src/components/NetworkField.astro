---
/**
 * Hero visual: an abstract network map — nodes and links in sand hairlines,
 * crossed by one electric-blue attack path. Generated at build time from a
 * fixed seed, so it is identical on every build and costs no image request.
 * The geometry lives in the design system so the exported SVG matches.
 */
import { createNetworkField } from '@johannlaqua/design-system/network-field';

const { width: W, height: H, nodes, links, path: pathNodes, pathD, entry, target } = createNetworkField();
---

<div class="field" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="field-glow" cx="0.78" cy="0.28" r="0.55">
        <stop offset="0" stop-color="var(--blue-500)" stop-opacity="0.28"></stop>
        <stop offset="1" stop-color="var(--blue-500)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <rect width={W} height={H} fill="url(#field-glow)"></rect>

    <g class="field__links">
      {links.map(({ a, b, o }) => (
        <line
          x1={a.x.toFixed(1)}
          y1={a.y.toFixed(1)}
          x2={b.x.toFixed(1)}
          y2={b.y.toFixed(1)}
          stroke-opacity={o.toFixed(2)}
        />
      ))}
    </g>

    <g class="field__nodes">
      {nodes.map((n) => (
        <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.r} />
      ))}
    </g>

    <path class="field__path-glow" d={pathD}></path>
    <path class="field__path" d={pathD} pathLength="1"></path>

    <g class="field__hops">
      {pathNodes.map((n) => (
        <rect x={(n.x - 4).toFixed(1)} y={(n.y - 4).toFixed(1)} width="8" height="8" />
      ))}
    </g>

    <circle class="field__entry" cx={entry.x.toFixed(1)} cy={entry.y.toFixed(1)} r="10"></circle>
    <circle class="field__target" cx={target.x.toFixed(1)} cy={target.y.toFixed(1)} r="16"></circle>
    <circle class="field__target-core" cx={target.x.toFixed(1)} cy={target.y.toFixed(1)} r="5"></circle>
  </svg>
</div>

<style>
  .field {
    width: 100%;
    height: 100%;
    mask-image:
      linear-gradient(to right, transparent 0%, black 38%), linear-gradient(to top, transparent 0%, black 30%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .field svg {
    width: 100%;
    height: 100%;
  }

  .field__links line {
    stroke: var(--sand-500);
    stroke-width: 1;
  }

  .field__nodes circle {
    fill: var(--sand-300);
    opacity: 0.55;
  }

  .field__path,
  .field__path-glow {
    fill: none;
    stroke: var(--blue-500);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .field__path {
    stroke-width: 2.5;
    stroke-dasharray: 1;
    animation: field-draw var(--duration-trace) var(--ease-out) 300ms both;
  }

  .field__path-glow {
    stroke-width: 12;
    stroke-opacity: 0.18;
  }

  .field__hops rect {
    fill: var(--charcoal-900);
    stroke: var(--blue-500);
    stroke-width: 2;
  }

  .field__entry {
    fill: none;
    stroke: var(--sand-300);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .field__target {
    fill: var(--blue-glow);
    stroke: var(--blue-500);
    stroke-width: 1.5;
  }

  .field__target-core {
    fill: var(--blue-500);
  }

  @keyframes field-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
