---
interface Props {
  /** Small tracked-caps line above the title (the section's name). */
  kicker?: string;
  title: string;
  /** Second half of the title, set in italic serif. */
  accent?: string;
  subtitle?: string;
  /** Heading level — h2 inside the home page, h1 on standalone pages. */
  as?: 'h1' | 'h2';
}

const { kicker, title, accent, subtitle, as: Tag = 'h2' }: Props = Astro.props;
---

<div class="heading">
  {kicker && <p class="kicker">{kicker}</p>}
  <Tag class="heading__title">
    {title}{accent && ' '}{accent && <span class="accent">{accent}</span>}
  </Tag>
  {subtitle && <p class="heading__subtitle">{subtitle}</p>}
</div>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    max-width: 46rem;
  }

  .heading__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .heading__subtitle {
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-text);
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .heading__title {
      font-size: var(--text-4xl);
    }
  }
</style>
