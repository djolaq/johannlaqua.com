---
// This page is prerendered once at build time (this is a fully static
// site), so it can't know which locale the visitor was browsing in when
// they hit a missing route. Rather than guess, the content below is shown
// in both languages; only the header/footer chrome defaults to the site's
// default locale (fr).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { defaultLocale, useTranslations, localizePath } from '../i18n/utils';

// One block per locale: a way back home, to the blog, and to the contact section.
const blocks = (['fr', 'en'] as const).map((locale) => {
  const t = useTranslations(locale);
  return {
    locale,
    t,
    links: [
      { href: localizePath(locale, '/'), label: t('notFound.cta') },
      { href: localizePath(locale, '/blog'), label: t('notFound.blog') },
      { href: `${localizePath(locale, '/')}#contact`, label: t('notFound.contact') },
    ],
  };
});
const t = useTranslations(defaultLocale);
---

<BaseLayout locale={defaultLocale} title={t('notFound.title')} description={t('notFound.description')} noindex>
  <section class="section not-found">
    <div class="container">
      <p class="not-found__code" aria-hidden="true">404</p>

      <div class="not-found__langs">
        {
          blocks.map(({ locale, t: tl, links }, index) => {
            const Heading = index === 0 ? 'h1' : 'h2';
            return (
              <div class="not-found__lang" lang={locale}>
                <Heading class="not-found__title">{tl('notFound.title')}</Heading>
                <p class="not-found__body">{tl('notFound.body')}</p>
                <nav class="not-found__nav" aria-label={tl('notFound.nav')}>
                  <Button href={links[0].href} variant={index === 0 ? 'primary' : 'quiet'}>
                    {links[0].label}
                  </Button>
                  <ul>
                    {links.slice(1).map((link) => (
                      <li>
                        <a class="link" href={link.href}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
  }

  .not-found__code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(6rem, 3rem + 18vw, 16rem);
    font-weight: var(--weight-regular);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    color: var(--text);
    -webkit-text-stroke: 0;
  }

  .not-found__langs {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--line-hair) solid var(--rule);
  }

  .not-found__lang {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .not-found__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
  }

  .not-found__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .not-found__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .not-found__body {
    max-width: 28rem;
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .not-found__langs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
