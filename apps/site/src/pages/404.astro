---
// This page is prerendered once at build time (this is a fully static
// site), so it can't know which locale the visitor was browsing in when
// they hit a missing route. Rather than guess, the content below is shown
// in both languages; only the header/footer chrome defaults to the site's
// default locale (fr).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { defaultLocale, useTranslations, localizePath } from '../i18n/utils';

const t = useTranslations(defaultLocale);
const tEn = useTranslations('en');
const home = localizePath(defaultLocale, '/');
const homeEn = localizePath('en', '/');
---

<BaseLayout locale={defaultLocale} title={t('notFound.title')} description={t('notFound.description')} noindex>
  <section class="section not-found">
    <div class="container">
      <p class="not-found__code" aria-hidden="true">404</p>

      <div class="not-found__langs">
        <div class="not-found__lang">
          <h1 class="not-found__title">{t('notFound.title')}</h1>
          <p class="not-found__body">{t('notFound.body')}</p>
          <Button href={home}>{t('notFound.cta')}</Button>
        </div>

        <div class="not-found__lang" lang="en">
          <h2 class="not-found__title">{tEn('notFound.title')}</h2>
          <p class="not-found__body">{tEn('notFound.body')}</p>
          <Button href={homeEn} variant="quiet">{tEn('notFound.cta')}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
  }

  .not-found__code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(6rem, 3rem + 18vw, 16rem);
    font-weight: var(--weight-regular);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    color: var(--text);
    -webkit-text-stroke: 0;
  }

  .not-found__langs {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--line-hair) solid var(--rule);
  }

  .not-found__lang {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .not-found__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
  }

  .not-found__body {
    max-width: 28rem;
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .not-found__langs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
