---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import TagFilter from '../../../components/TagFilter.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { useTranslations } from '../../../i18n/utils';
import { publishedPosts, tagsOf } from '../../../lib/blog';

const locale = 'en' as const;
const t = useTranslations(locale);

const allPosts = await getCollection('blog');
const posts = publishedPosts(allPosts, locale);
const tags = tagsOf(allPosts, locale);
---

<BaseLayout locale={locale} title={t('blog.pageTitle')} description={t('blog.subtitle')}>
  <Section>
    <SectionHeading
      as="h1"
      kicker={t('blog.eyebrow')}
      title={t('blog.title')}
      accent={t('blog.titleAccent')}
      subtitle={t('blog.subtitle')}
    />

    <TagFilter locale={locale} tags={tags} />
    <PostGrid locale={locale} posts={posts} />
  </Section>
</BaseLayout>
