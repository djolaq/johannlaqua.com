---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { useTranslations, localizePath, locales, ogImagePath, type Locale } from '../i18n/utils';
import { name } from '../config/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  /** Shared id linking this post to its translation, used to resolve the language-switch link. */
  translationId: string;
}

const { locale, title, description, date, tags, translationId } = Astro.props;
const t = useTranslations(locale);

const otherLocale = locales.find((l) => l !== locale)!;
const counterpart = (await getCollection('blog')).find(
  (post) => post.id.startsWith(`${otherLocale}/`) && post.data.translationId === translationId && !post.data.draft,
);
// Fall back to the blog index in the other locale when no translated counterpart exists,
// since the slug (and therefore the naive prefix-swap) isn't guaranteed to match.
const altHref = counterpart
  ? localizePath(otherLocale, `/blog/${counterpart.id.replace(`${otherLocale}/`, '')}`)
  : localizePath(otherLocale, '/blog');
const formattedDate = date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// schema.org BlogPosting + BreadcrumbList (Home › Blog › post), merged into
// BaseLayout's graph so `author`/`publisher` can point at its Person node.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const person = { '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name, url: new URL('/', Astro.site).href };
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#article`,
    headline: title,
    description,
    datePublished: date.toISOString(),
    // No separate "updated" field in the content schema yet: a post is
    // last modified when it is published.
    dateModified: date.toISOString(),
    author: person,
    publisher: person,
    image: new URL(ogImagePath(Astro.url.pathname), Astro.site).href,
    inLanguage: locale,
    keywords: tags,
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: t('blog.breadcrumbHome'), item: new URL(localizePath(locale, '/'), Astro.site).href },
      { name: t('blog.pageTitle'), item: new URL(localizePath(locale, '/blog'), Astro.site).href },
      { name: title, item: pageUrl },
    ].map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, ...crumb })),
  },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  altHref={altHref}
  ogType="article"
  publishedTime={date.toISOString()}
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="post__header">
      <div class="container post__header-inner">
        <a class="post__back" href={localizePath(locale, '/blog')}>← {t('blog.back')}</a>
        <p class="kicker">{t('blog.eyebrow')}</p>
        <h1 class="post__title">{title}</h1>
        <p class="post__description">{description}</p>
        <p class="post__meta">
          <time class="mono" datetime={date.toISOString()}>{formattedDate}</time>
          {tags.map((tag) => <span class="mono">#{tag}</span>)}
        </p>
      </div>
    </header>

    <div class="container post__body">
      <div class="prose post__content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post__header {
    padding-block: var(--space-7) var(--space-7);
    border-bottom: var(--line-hair) solid var(--rule);
    background: radial-gradient(50% 120% at 90% 0%, var(--blue-glow), transparent 70%);
  }

  .post__header-inner {
    max-width: calc(52rem + 2 * var(--gutter));
  }

  .post__back {
    display: block;
    width: fit-content;
    margin-bottom: var(--space-7);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
  }

  .post__back:hover {
    color: var(--text);
  }

  .post__title {
    margin-top: var(--space-5);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .post__description {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--line-hair) solid var(--rule);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .post__body {
    max-width: calc(52rem + 2 * var(--gutter));
    padding-block: var(--space-8) var(--space-9);
  }

  /* First paragraph reads as a lede: lighter and larger. */
  .post__content > :global(p:first-child) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  @media (min-width: 48em) {
    .post__title {
      font-size: var(--text-4xl);
    }
  }
</style>
