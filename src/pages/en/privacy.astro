---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalArticle from '../../components/LegalArticle.astro';
import { useTranslations } from '../../i18n/utils';
import { legal } from '../../data/legal';

const locale = 'en' as const;
const t = useTranslations(locale);
const { publisher, host } = legal;
---

<BaseLayout locale={locale} title={t('legal.privacy.title')} altHref="/confidentialite">
  <LegalArticle locale={locale} title={t('legal.privacy.title')}>
    <p>
      This site is deliberately minimal: no cookies, no trackers, no analytics, no forms, no fonts or scripts
      loaded from third-party services. This page describes the only data that may still be processed.
    </p>

    <h2>Data controller</h2>
    <p>
      {publisher.name} — <a href={`mailto:${publisher.email}`}>{publisher.email}</a>
    </p>

    <h2>Hosting server logs</h2>
    <p>
      Like any website, the hosting provider's server ({host.name}) automatically records access logs: IP address,
      date and time, requested page, browser. This data is used solely to run and secure the site (legitimate
      interest, GDPR art. 6(1)(f)). It is not used for any other purpose and is deleted after a limited period set
      by the host.
    </p>

    <h2>Email exchanges</h2>
    <p>
      If you email me, I receive your email address and your message. I use them only to reply and, where
      relevant, to follow up on your request (pre-contractual steps or legitimate interest). They are never sold or
      shared with third parties and are kept for at most 3 years after our last exchange, unless a contract is in
      progress.
    </p>

    <h2>Cookies</h2>
    <p>No cookies are set on your device, which is why you don't see a consent banner.</p>

    <h2>Your rights</h2>
    <p>Under the GDPR and the French Data Protection Act, you have the right to:</p>
    <ul>
      <li>access, rectify and erase your data;</li>
      <li>restrict or object to processing;</li>
      <li>data portability.</li>
    </ul>
    <p>
      To exercise them, write to <a href={`mailto:${publisher.email}`}>{publisher.email}</a>. If you believe your
      rights are not being respected, you can lodge a complaint with the CNIL, the French data protection authority
      (<a href="https://www.cnil.fr/en" target="_blank" rel="noopener noreferrer">cnil.fr</a>).
    </p>
  </LegalArticle>
</BaseLayout>
