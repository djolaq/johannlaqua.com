---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { locale, href, title, description, date, tags } = Astro.props;
const t = useTranslations(locale);
const formattedDate = date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a class="post-card__link" href={href}>
    <div class="post-card__meta">
      <time class="mono" datetime={date.toISOString()}>{formattedDate}</time>
      {tags.length > 0 && <span class="post-card__tag">{tags[0]}</span>}
    </div>
    <h3 class="post-card__title">{title}</h3>
    <p class="post-card__description">{description}</p>
    <span class="post-card__cta">{t('blog.readMore')} →</span>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--color-border-strong);
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .post-card__tag {
    padding: 0.2em 0.6em;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .post-card__title {
    font-size: var(--text-lg);
  }

  .post-card__description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    flex: 1;
  }

  .post-card__cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-signal-strong);
  }
</style>
