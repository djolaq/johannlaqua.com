---
/** One journal entry, rendered as a log line: ISO date | title + description. */
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { href, title, description, date, tags } = Astro.props;
const isoDate = date.toISOString().slice(0, 10);
---

<article class="entry">
  <a class="entry__link" href={href}>
    <time class="entry__date mono" datetime={date.toISOString()}>{isoDate}</time>
    <div class="entry__main">
      <h3 class="entry__title">{title}</h3>
      <p class="entry__description">{description}</p>
    </div>
    {tags.length > 0 && <p class="entry__tags mono">{tags.map((tag) => `#${tag}`).join(' ')}</p>}
  </a>
</article>

<style>
  .entry {
    border-top: var(--line-hair) solid var(--rule-strong);
  }

  .entry__link {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5) var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .entry__date,
  .entry__tags {
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--text-muted);
  }

  .entry__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    font-stretch: var(--stretch-ui);
    line-height: var(--leading-snug);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: var(--line-bold);
    text-underline-offset: var(--underline-offset);
    transition: text-decoration-color var(--duration-base) var(--ease-out);
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    text-decoration-color: var(--accent-stroke);
  }

  .entry__description {
    margin-top: var(--space-2);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .entry__link {
      grid-template-columns: 7.5rem minmax(0, 1fr) auto;
      align-items: baseline;
    }

    .entry__title {
      font-size: var(--text-2xl);
      font-weight: var(--weight-heavy);
      font-stretch: var(--stretch-display);
      line-height: var(--leading-tight);
    }
  }
</style>
