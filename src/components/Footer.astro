---
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import { name, social } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');
const year = new Date().getFullYear();

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];

const legalLinks = [
  { href: localizePath(locale, locale === 'fr' ? '/mentions-legales' : '/legal-notice'), label: t('footer.legalNotice') },
  { href: localizePath(locale, locale === 'fr' ? '/confidentialite' : '/privacy'), label: t('footer.privacy') },
];
---

<footer class="footer tone-charcoal">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href={home}>{name}</a>
      <p>{t('footer.builtWith')}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer__social">
      {
        social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener noreferrer">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {name}. {t('footer.rights')}</p>
    <ul class="footer__legal-links">
      {
        legalLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-6);
    border-top: var(--line-hair) solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .footer__brand a {
    font-size: var(--text-lg);
    font-weight: var(--weight-heavy);
    font-stretch: var(--stretch-display);
    text-decoration: none;
  }

  .footer__brand p {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }

  .footer__nav ul,
  .footer__social,
  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer a:hover {
    color: var(--text);
  }

  .footer__brand a {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-5);
    /* Hairline aligned to the content box, not the padded container. */
    background: linear-gradient(var(--rule), var(--rule)) no-repeat center top / calc(100% - 2 * var(--gutter))
      var(--line-hair);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (min-width: 56em) {
    .footer__inner {
      grid-template-columns: 1fr auto auto;
      column-gap: var(--space-8);
      align-items: start;
    }
  }
</style>
