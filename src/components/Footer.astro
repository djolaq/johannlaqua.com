---
import { useTranslations, localizePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');
const year = new Date().getFullYear();

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];

const social = [
  { href: 'https://github.com/', label: 'GitHub' },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href={home} class="mono">JL_</a>
      <p>{t('footer.builtWith')}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="footer__social">
      {
        social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container">
    <p class="footer__legal">© {year} Johann Laqua. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-7) var(--space-6);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .footer__brand a {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-signal-strong);
    text-decoration: none;
  }

  .footer__brand p {
    margin-top: var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .footer__nav ul,
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
  }

  .footer__nav a,
  .footer__social a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer__nav a:hover,
  .footer__social a:hover {
    color: var(--color-signal-strong);
  }

  .footer__legal {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  @media (min-width: 56em) {
    .footer__inner {
      grid-template-columns: 1fr auto auto;
      align-items: start;
    }
  }
</style>
