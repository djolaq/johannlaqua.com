---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<figure class="avatar">
  <Image
    src={avatar}
    alt={alt}
    class="avatar__img"
    widths={[224, 608]}
    sizes="(min-width: 48em) 19rem, 7rem"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  /* A sand print on charcoal, offset from an electric-blue registration
     frame — like a proof pulled slightly out of register. */
  .avatar {
    position: relative;
    width: var(--avatar-size-sm);
    margin: 0 var(--space-3) var(--space-3) 0;
    padding: var(--space-2);
    background: var(--sand-300);
    border-radius: var(--radius-xs);
  }

  .avatar::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    translate: var(--space-3) var(--space-3);
    box-shadow: inset 0 0 0 var(--line-bold) var(--blue-500);
    border-radius: var(--radius-xs);
  }

  .avatar__img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xs);
    filter: grayscale(1) contrast(1.08);
  }

  @media (min-width: 48em) {
    .avatar {
      width: var(--avatar-size-lg);
      margin: 0 var(--space-5) var(--space-5) 0;
    }

    .avatar::before {
      translate: var(--space-5) var(--space-5);
    }

    .avatar {
      padding: var(--space-3);
    }
  }
</style>
