---
import { getAlternateLocalePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Explicit target path in the other locale, overriding the naive prefix-swap (needed for pages whose slug differs per locale, e.g. blog posts). */
  href?: string;
}

const { locale, href } = Astro.props;
const alternate = getAlternateLocalePath(locale, Astro.url.pathname);
const labels: Record<Locale, string> = { fr: 'FR', en: 'EN' };
---

<a
  class="lang-toggle"
  href={href ?? alternate.path}
  hreflang={alternate.locale}
  aria-label={`Switch language to ${labels[alternate.locale]}`}
>
  {labels[alternate.locale]}
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 var(--line-hair) var(--rule);
    text-decoration: none;
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .lang-toggle:hover {
    box-shadow: inset 0 0 0 var(--line-hair) var(--text);
  }
</style>
