---
import { getAlternateLocalePath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Explicit target path in the other locale, overriding the naive prefix-swap (needed for pages whose slug differs per locale, e.g. blog posts). */
  href?: string;
}

const { locale, href } = Astro.props;
const alternate = getAlternateLocalePath(locale, Astro.url.pathname);
const labels: Record<Locale, string> = { fr: 'FR', en: 'EN' };
---

<a
  class="lang-toggle"
  href={href ?? alternate.path}
  hreflang={alternate.locale}
  aria-label={`Switch language to ${labels[alternate.locale]}`}
>
  {labels[alternate.locale]}
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .lang-toggle:hover {
    color: var(--color-signal-strong);
    border-color: var(--color-signal);
  }
</style>
