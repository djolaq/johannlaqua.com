---
/**
 * Hero visual: an abstract network map — nodes and links in sand hairlines,
 * crossed by one electric-blue attack path. Generated at build time from a
 * fixed seed, so it is identical on every build and costs no image request.
 */
const W = 800;
const H = 800;
const COLS = 9;
const ROWS = 9;

// Small deterministic PRNG (mulberry32).
let seed = 0x4a4c; // "JL"
const rand = () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

type Node = { x: number; y: number; r: number };
const nodes: Node[] = [];
for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    nodes.push({
      x: ((col + 0.5) / COLS) * W + (rand() - 0.5) * 70,
      y: ((row + 0.5) / ROWS) * H + (rand() - 0.5) * 70,
      r: rand() < 0.15 ? 3.2 : 1.8,
    });
  }
}
const at = (col: number, row: number) => nodes[row * COLS + col];

// Links: right and down neighbours, plus some diagonals; a few are skipped.
const links: { a: Node; b: Node; o: number }[] = [];
for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    const n = at(col, row);
    if (col < COLS - 1 && rand() > 0.18) links.push({ a: n, b: at(col + 1, row), o: 0.25 + rand() * 0.5 });
    if (row < ROWS - 1 && rand() > 0.18) links.push({ a: n, b: at(col, row + 1), o: 0.25 + rand() * 0.5 });
    if (col < COLS - 1 && row < ROWS - 1 && rand() > 0.72) links.push({ a: n, b: at(col + 1, row + 1), o: 0.2 + rand() * 0.3 });
  }
}

// The attack path: from an entry point on the left to a target near the top right.
const pathCells: [number, number][] = [
  [1, 7], [2, 6], [3, 6], [4, 5], [5, 4], [5, 3], [6, 2], [7, 2],
];
const pathNodes = pathCells.map(([c, r]) => at(c, r));
const pathD = pathNodes.map((n, i) => `${i ? 'L' : 'M'}${n.x.toFixed(1)} ${n.y.toFixed(1)}`).join(' ');
const entry = pathNodes[0];
const target = pathNodes[pathNodes.length - 1];
---

<div class="field" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="field-glow" cx="0.78" cy="0.28" r="0.55">
        <stop offset="0" stop-color="var(--blue-500)" stop-opacity="0.28"></stop>
        <stop offset="1" stop-color="var(--blue-500)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <rect width={W} height={H} fill="url(#field-glow)"></rect>

    <g class="field__links">
      {
        links.map(({ a, b, o }) => (
          <line x1={a.x.toFixed(1)} y1={a.y.toFixed(1)} x2={b.x.toFixed(1)} y2={b.y.toFixed(1)} stroke-opacity={o.toFixed(2)} />
        ))
      }
    </g>

    <g class="field__nodes">
      {nodes.map((n) => <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.r} />)}
    </g>

    <path class="field__path-glow" d={pathD}></path>
    <path class="field__path" d={pathD} pathLength="1"></path>

    <g class="field__hops">
      {pathNodes.map((n) => <rect x={(n.x - 4).toFixed(1)} y={(n.y - 4).toFixed(1)} width="8" height="8" />)}
    </g>

    <circle class="field__entry" cx={entry.x.toFixed(1)} cy={entry.y.toFixed(1)} r="10"></circle>
    <circle class="field__target" cx={target.x.toFixed(1)} cy={target.y.toFixed(1)} r="16"></circle>
    <circle class="field__target-core" cx={target.x.toFixed(1)} cy={target.y.toFixed(1)} r="5"></circle>
  </svg>
</div>

<style>
  .field {
    width: 100%;
    height: 100%;
    mask-image:
      linear-gradient(to right, transparent 0%, black 38%),
      linear-gradient(to top, transparent 0%, black 30%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .field svg {
    width: 100%;
    height: 100%;
  }

  .field__links line {
    stroke: var(--sand-500);
    stroke-width: 1;
  }

  .field__nodes circle {
    fill: var(--sand-300);
    opacity: 0.55;
  }

  .field__path,
  .field__path-glow {
    fill: none;
    stroke: var(--blue-500);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .field__path {
    stroke-width: 2.5;
    stroke-dasharray: 1;
    animation: field-draw var(--duration-trace) var(--ease-out) 300ms both;
  }

  .field__path-glow {
    stroke-width: 12;
    stroke-opacity: 0.18;
  }

  .field__hops rect {
    fill: var(--charcoal-900);
    stroke: var(--blue-500);
    stroke-width: 2;
  }

  .field__entry {
    fill: none;
    stroke: var(--sand-300);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .field__target {
    fill: var(--blue-glow);
    stroke: var(--blue-500);
    stroke-width: 1.5;
  }

  .field__target-core {
    fill: var(--blue-500);
  }

  @keyframes field-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
