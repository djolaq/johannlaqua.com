---
import { getCollection } from 'astro:content';
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import BlogCard from './BlogCard.astro';
import Button from './Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const stripLocale = (id: string) => id.replace(`${locale}/`, '');
---

<Section id="blog">
  <div class="blog-preview__head">
    <SectionHeading
      kicker={t('blog.eyebrow')}
      title={t('blog.title')}
      accent={t('blog.titleAccent')}
      subtitle={t('blog.subtitle')}
    />
    <Button href={localizePath(locale, '/blog')} variant="quiet">{t('blog.viewAll')}</Button>
  </div>

  {
    posts.length > 0 ? (
      <div class="blog-preview__grid">
        {posts.map((post) => (
          <BlogCard
            locale={locale}
            href={localizePath(locale, `/blog/${stripLocale(post.id)}`)}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="blog-preview__empty">{t('blog.empty')}</p>
    )
  }
</Section>

<style>
  .blog-preview__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .blog-preview__head :global(.heading) {
    margin-bottom: 0;
  }

  .blog-preview__grid {
    display: grid;
    gap: var(--space-4);
  }

  .blog-preview__empty {
    color: var(--text-muted);
  }

  @media (min-width: 48em) {
    .blog-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72em) {
    .blog-preview__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
