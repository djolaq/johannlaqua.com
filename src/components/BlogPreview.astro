---
import { getCollection } from 'astro:content';
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import BlogCard from './BlogCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const stripLocale = (id: string) => id.replace(`${locale}/`, '');
---

<Section id="blog" label={t('blog.eyebrow')} class="blog-preview">
  <SectionHeading title={t('blog.title')} subtitle={t('blog.subtitle')} />

  {
    posts.length > 0 ? (
      <div class="blog-preview__list">
        {posts.map((post) => (
          <BlogCard
            locale={locale}
            href={localizePath(locale, `/blog/${stripLocale(post.id)}`)}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="blog-preview__empty">{t('blog.empty')}</p>
    )
  }

  <a class="blog-preview__all link" href={localizePath(locale, '/blog')}>{t('blog.viewAll')}</a>
</Section>

<style>
  .blog-preview :global(.section-grid__main) {
    display: flex;
    flex-direction: column;
  }

  .blog-preview__list {
    border-bottom: var(--line-hair) solid var(--rule-strong);
  }

  .blog-preview__empty {
    color: var(--text-muted);
  }

  .blog-preview__all {
    align-self: flex-start;
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
  }
</style>
