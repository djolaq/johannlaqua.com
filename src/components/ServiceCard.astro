---
interface Props {
  icon: 'code' | 'shield' | 'compass';
  title: string;
  body: string;
  badge?: string;
}

const { icon, title, body, badge } = Astro.props;

// Simple line icons (24×24, stroke = currentColor).
const icons: Record<Props['icon'], string> = {
  code: 'M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16',
  shield: 'M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6L12 3Zm-3 9 2 2 4-4',
  compass: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm3.5-12.5-2 5-5 2 2-5 5-2Z',
};
---

<article class:list={['service', 'card', { 'service--featured': badge }]}>
  <div class="service__top">
    <span class="service__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d={icons[icon]}></path></svg>
    </span>
    {badge && <span class="service__badge">{badge}</span>}
  </div>
  <h3 class="service__title">{title}</h3>
  <p class="service__body">{body}</p>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-6);
  }

  .service--featured {
    border-color: var(--blue-500);
    box-shadow: 0 0 0 var(--line-hair) var(--blue-500), 0 30px 60px -30px var(--blue-glow);
  }

  .service__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--blue-300);
    background: var(--sand-veil);
    border: var(--line-hair) solid var(--rule);
    border-radius: var(--radius-sm);
  }

  .service__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .service__badge {
    padding: 0.25em 0.7em;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--on-blue);
    background: var(--blue-500);
    border-radius: var(--radius-full);
  }

  .service__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }

  .service__body {
    font-size: var(--text-sm);
    line-height: var(--leading-text);
    color: var(--text-muted);
  }
</style>
