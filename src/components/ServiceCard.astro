---
/** One service, rendered as a ruled row (title | description), not a card. */
interface Props {
  title: string;
  body: string;
  badge?: string;
}

const { title, body, badge } = Astro.props;
---

<article class="service">
  <h3 class="service__title">
    {title}
    {badge && <span class="service__badge">{badge}</span>}
  </h3>
  <p class="service__body">{body}</p>
</article>

<style>
  .service {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: var(--line-hair) solid var(--rule-strong);
  }

  .service__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-heavy);
    line-height: var(--leading-tight);
  }

  .service__badge {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    font-stretch: var(--stretch-ui);
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--on-blue);
    background: var(--blue-500);
    border-radius: var(--radius-xs);
  }

  .service__body {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  @media (min-width: 56em) {
    .service {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-7);
      align-items: baseline;
    }

    .service__body {
      font-size: var(--text-lg);
      font-weight: var(--weight-light);
      line-height: var(--leading-snug);
    }
  }
</style>
