---
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');

const navItems = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={home} class="header__brand mono">JL_</a>

    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageToggle locale={locale} href={altHref} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(10, 13, 16, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .header__brand {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-decoration: none;
    color: var(--color-signal-strong);
  }

  .header__nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .header__nav::-webkit-scrollbar {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-4);
    width: max-content;
  }

  .header__nav a {
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .header__nav a:hover {
    color: var(--color-text);
  }

  @media (min-width: 56em) {
    .header__nav ul {
      gap: var(--space-6);
    }
  }
</style>
