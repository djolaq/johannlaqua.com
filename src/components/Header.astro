---
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import { name } from '../config/site';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  locale: Locale;
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const t = useTranslations(locale);
const home = localizePath(locale, '/');

const navItems = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#services`, label: t('nav.services') },
  { href: localizePath(locale, '/blog'), label: t('nav.blog') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="header tone-charcoal">
  <div class="container header__inner">
    <a href={home} class="header__brand">
      <span class="header__mark" aria-hidden="true"></span>
      {name}
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageToggle locale={locale} href={altHref} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--line-hair) solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    font-stretch: var(--stretch-display);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    text-decoration: none;
  }

  /* Brand mark: a sand square with an electric-blue corner — the palette in one glyph. */
  .header__mark {
    width: 0.8em;
    height: 0.8em;
    background: linear-gradient(135deg, var(--sand-300) 0 62%, var(--blue-500) 62% 100%);
    border-radius: var(--radius-xs);
  }

  .header__nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .header__nav::-webkit-scrollbar {
    display: none;
  }

  .header__nav ul {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-5);
    width: max-content;
    margin-left: auto;
  }

  .header__nav a {
    display: inline-block;
    padding-block: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .header__nav a:hover {
    color: var(--text);
  }

  @media (max-width: 40em) {
    .header__inner {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: var(--space-3);
    }

    .header__brand {
      flex: 1;
    }

    .header__nav {
      order: 3;
      flex-basis: 100%;
    }

    .header__nav ul {
      justify-content: flex-start;
      margin-left: 0;
    }
  }

  @media (min-width: 56em) {
    .header__nav ul {
      gap: var(--space-6);
    }
  }
</style>
