---
interface Props {
  name: string;
  href: string;
  description: string;
  stack: readonly string[];
  linkLabel: string;
}

const { name, href, description, stack, linkLabel } = Astro.props;
---

<article class="project">
  <h3 class="project__name mono">{name}</h3>
  <p class="project__body">{description}</p>
  <ul class="project__stack">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
  <a class="project__link" href={href} target="_blank" rel="noopener noreferrer">
    {linkLabel} ↗
  </a>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg-inset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .project:hover {
    border-color: var(--color-border-strong);
  }

  .project__name {
    font-size: var(--text-base);
    color: var(--color-signal-strong);
  }

  .project__body {
    flex: 1;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project__stack li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.15em 0.55em;
  }

  .project__link {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .project__link:hover {
    color: var(--color-signal-strong);
  }
</style>
