---
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import { email, social } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="contact" label={t('contact.eyebrow')} tone="charcoal" class="contact">
  <h2 class="contact__title">{t('contact.title')}</h2>
  <p class="contact__subtitle">{t('contact.subtitle')}</p>

  <a class="contact__email" href={`mailto:${email}`} aria-label={`${t('contact.cta')} : ${email}`}>
    {email}
  </a>

  <div class="contact__social">
    <p>{t('contact.social')}</p>
    <ul>
      {
        social.map((s) => (
          <li>
            <a class="link" href={s.href} target="_blank" rel="me noopener noreferrer">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .contact {
    padding-block: var(--space-10) var(--space-9);
  }

  .contact__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-heavy);
  }

  .contact__subtitle {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-lg);
    font-weight: var(--weight-light);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  /* The poster moment: the address itself is the call to action, set huge
     and thin against the heavy headings. */
  .contact__email {
    display: inline-block;
    margin-top: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--text-poster);
    font-weight: var(--weight-thin);
    font-stretch: var(--stretch-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--sand-300);
    overflow-wrap: anywhere;
    text-decoration-line: underline;
    text-decoration-color: var(--blue-500);
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
    transition:
      color var(--duration-base) var(--ease-out),
      font-weight var(--duration-base) var(--ease-out);
  }

  .contact__email:hover {
    color: var(--blue-300);
    font-weight: var(--weight-regular);
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--line-hair) solid var(--rule);
    font-family: var(--font-display);
  }

  .contact__social p {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .contact__social ul {
    display: flex;
    gap: var(--space-5);
  }

  .contact__social a {
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 48em) {
    .contact__title {
      font-size: var(--text-4xl);
      line-height: var(--leading-display);
      letter-spacing: var(--tracking-display);
    }
  }
</style>
