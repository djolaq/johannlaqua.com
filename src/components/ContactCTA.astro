---
import { useTranslations, type Locale } from '../i18n/utils';
import Button from './Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const email = 'johann@laqua.fr';
const social = [
  { href: 'https://github.com/', label: 'GitHub' },
  { href: 'https://www.linkedin.com/', label: 'LinkedIn' },
];
---

<section id="contact" class="section contact">
  <div class="container contact__inner">
    <p class="eyebrow">{t('contact.eyebrow')}</p>
    <h2 class="contact__title">{t('contact.title')}</h2>
    <p class="contact__subtitle">{t('contact.subtitle')}</p>

    <div class="contact__actions">
      <Button href={`mailto:${email}`}>{t('contact.cta')}</Button>
    </div>

    <div class="contact__social">
      <span>{t('contact.social')}</span>
      <ul>
        {
          social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    max-width: 36rem;
    text-align: center;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact__title {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
  }

  .contact__subtitle {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .contact__actions {
    margin-top: var(--space-6);
  }

  .contact__social {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .contact__social span {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
  }

  .contact__social ul {
    display: flex;
    gap: var(--space-5);
  }

  .contact__social a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .contact__social a:hover {
    color: var(--color-signal-strong);
  }

  @media (min-width: 48em) {
    .contact__title {
      font-size: var(--text-3xl);
    }
  }
</style>
