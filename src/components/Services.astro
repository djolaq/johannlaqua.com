---
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const services = [
  { icon: 'code', title: t('services.dev.title'), body: t('services.dev.body') },
  {
    icon: 'shield',
    title: t('services.security.title'),
    body: t('services.security.body'),
    badge: t('services.security.badge'),
  },
  { icon: 'compass', title: t('services.advisory.title'), body: t('services.advisory.body') },
] as const;
---

<Section id="services">
  <SectionHeading
    kicker={t('services.eyebrow')}
    title={t('services.title')}
    accent={t('services.titleAccent')}
    subtitle={t('services.subtitle')}
  />
  <ul class="services__grid">
    {
      services.map((service) => (
        <li>
          <ServiceCard {...service} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services__grid {
    display: grid;
    gap: var(--space-4);
  }

  .services__grid li {
    display: flex;
  }

  @media (min-width: 56em) {
    .services__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
