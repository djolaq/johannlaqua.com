---
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const services = [
  { title: t('services.dev.title'), body: t('services.dev.body') },
  { title: t('services.security.title'), body: t('services.security.body'), badge: t('services.security.badge') },
  { title: t('services.advisory.title'), body: t('services.advisory.body') },
];
---

<Section id="services" label={t('services.eyebrow')}>
  <SectionHeading title={t('services.title')} subtitle={t('services.subtitle')} />
  <ul class="services__list">
    {
      services.map((service) => (
        <li>
          <ServiceCard {...service} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services__list {
    border-bottom: var(--line-hair) solid var(--rule-strong);
  }
</style>
