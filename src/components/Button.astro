---
interface Props {
  href: string;
  variant?: 'primary' | 'quiet';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  /* The only filled colour on the page: an action. */
  .btn--primary {
    background: var(--blue-500);
    color: var(--on-blue);
  }

  .btn--primary:hover {
    background: var(--blue-600);
  }

  .btn--quiet {
    color: var(--text);
    box-shadow: inset 0 0 0 var(--line-hair) var(--rule);
  }

  .btn--quiet:hover {
    box-shadow: inset 0 0 0 var(--line-hair) var(--text);
  }

  .btn:active {
    translate: 0 1px;
  }
</style>
